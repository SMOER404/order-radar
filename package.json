{
  "name": "order-radar",
  "version": "0.1.0",
  "private": true,
  "description": "Сбор заказов с FL.ru, Kwork и Telegram-каналов, LLM-оценка и уведомления в Telegram-бота",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "tg:login": "node --env-file-if-exists=.env dist/scripts/tg-login.js",
    "collect:once": "node --env-file-if-exists=.env dist/scripts/collect-once.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/schedule": "^6.0.0",
    "@prisma/client": "^6.19.0",
    "grammy": "^1.36.0",
    "https-proxy-agent": "^7.0.6",
    "reflect-metadata": "^0.2.2",
    "rss-parser": "^3.13.0",
    "rxjs": "^7.8.1",
    "socks-proxy-agent": "^8.0.5",
    "telegram": "^2.26.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.0.0",
    "prisma": "^6.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
