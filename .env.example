# Скопируйте в .env и заполните.
# Docker: DATABASE_URL задаётся в docker-compose.yml, здесь нужен только POSTGRES_PASSWORD.
POSTGRES_PASSWORD=change-me
# Без Docker (pm2 + существующий Postgres):
# DATABASE_URL=postgresql://order_radar:ПАРОЛЬ@127.0.0.1:5432/order_radar?schema=public

# ---- Расписание ----
COLLECT_INTERVAL_MIN=20
MAX_ORDER_AGE_HOURS=48

# ---- Прокси (если сервер в РФ не видит api.telegram.org или LLM блокирует IP) ----
# http://user:pass@host:port или socks5://user:pass@host:port. MTProto (чтение каналов) умеет только socks5.
PROXY_URL=
BOT_USE_PROXY=true
TG_USE_PROXY=true
LLM_USE_PROXY=false

# ---- Бот (создать у @BotFather) ----
# Альтернатива прокси: свой адрес Bot API (reverse-proxy на api.telegram.org на зарубежном сервере)
BOT_API_ROOT=
BOT_TOKEN=
# Пусто при первом запуске: напишите боту /start, он пришлёт chat id
BOT_OWNER_CHAT_ID=

# ---- Ставка ----
# Минимальная реальная ставка ₽/час (открытый вопрос: подберите сами; курьер = 400)
MIN_RATE_RUB=800
NOTIFY_BELOW_MIN_RATE=false
NOTIFY_REJECTED=false

# ---- FL.ru ----
FL_ENABLED=true
# несколько лент через запятую
FL_RSS_URLS=https://www.fl.ru/rss/all.xml?category=5

# ---- Kwork ----
KWORK_ENABLED=true
# 11 = «Разработка и IT». Номер категории виден в адресе https://kwork.ru/projects?c=...
KWORK_CATEGORIES=11
KWORK_PAGES=1

# ---- Telegram-каналы (отдельный аккаунт, только чтение) ----
TG_ENABLED=false
# https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# docker compose run --rm app npm run tg:login
TG_SESSION=
# @канал или t.me/канал через запятую; можно и в config/filters.yaml
TG_CHANNELS=
TG_FETCH_LIMIT=50

# ---- LLM (любой OpenAI-совместимый API) ----
LLM_ENABLED=true
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-chat
LLM_MAX_PER_RUN=30
LLM_MAX_TOKENS=1500
# Отключить «размышления» у думающих моделей (формат см. в документации провайдера), например:
# LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
LLM_EXTRA_BODY=
# false, если провайдер не поддерживает response_format=json_object
LLM_JSON_MODE=true
